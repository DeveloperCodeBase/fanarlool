[Unit]
Description=FanarLool dedicated daily database backup

[Service]
Type=oneshot
User=ubuntu
Group=www-data
ExecStart=/usr/bin/python3 /var/www/fanarlool/current/ops/backup/fanarlool-backup.py --root /var/www/fanarlool/shared --mode backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/fanarlool/shared
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=150
MemoryMax=256M

